# Copy to .env, fill in, then: chmod 600 .env
# CouchDB admin (server-wide superuser, only used for setup/maintenance)
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=change-me-admin

# Limited user the Obsidian LiveSync plugin logs in as
OBSIDIAN_USER=obsidian
OBSIDIAN_PASSWORD=change-me-obsidian

# Database name for the vault
VAULT_DB=vault

# Where CouchDB stores its data. Put this on the SSD, not the SD card.
DATA_DIR=/mnt/ssd/couchdb
