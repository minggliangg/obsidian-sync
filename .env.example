# Copy to .env and fill in. Generate passwords with: openssl rand -base64 24

# CouchDB admin (server management only, don't put this in Obsidian)
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=change-me

# Account Obsidian uses to sync
OBSIDIAN_USER=obsidian
OBSIDIAN_PASSWORD=change-me-too

# One database per vault
VAULT_DB=vault

# Where CouchDB stores data. Use the SSD mount.
DATA_DIR=/mnt/ssd/couchdb
